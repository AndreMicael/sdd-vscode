{
  "name": "sdd-speckit",
  "displayName": "SDD (Spec Kit)",
  "description": "Painel do Spec Kit (SDD): em que passo cada feature está, wiki de cada passo e comandos /speckit-* no Claude Code, Cursor, Codex, OpenCode ou Antigravity.",
  "version": "0.13.0",
  "publisher": "desenvolve-mt",
  "license": "UNLICENSED",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "main": "./extension.js",
  "activationEvents": ["workspaceContains:.specify/init-options.json", "workspaceContains:*/.specify/init-options.json", "onView:sdd.features"],
  "scripts": { "test": "node --test" },
  "contributes": {
    "viewsContainers": {
      "activitybar": [{ "id": "sdd", "title": "SDD", "icon": "media/sdd.svg" }]
    },
    "views": {
      "sdd": [
        { "id": "sdd.status", "name": "Onde estou" },
        { "id": "sdd.features", "name": "Features" },
        { "type": "webview", "id": "sdd.form", "name": "Ação" }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sdd.status",
        "contents": "Nenhuma feature ainda. Comece criando uma:\n[Nova feature](command:sdd.novaFeature)"
      },
      {
        "view": "sdd.features",
        "contents": "Nenhum repositório git na pasta aberta. Abra a pasta de um projeto (ou a pasta que contém vários).\n[Nova feature](command:sdd.novaFeature)"
      }
    ],
    "configuration": {
      "title": "SDD",
      "properties": {
        "sdd.orquestracao": {
          "type": "string",
          "enum": ["desligada", "orq", "orq-lazy"],
          "default": "desligada",
          "enumDescriptions": ["Claude faz tudo sozinho", "Claude delega ao Codex/Cursor/OpenCode (/orq)", "Delega e faz a menor mudan\u00e7a poss\u00edvel (/orq-lazy)"],
          "description": "S\u00f3 vale com a IA Claude Code e nos passos Plan, Tasks, Analyze, Implement e Converge."
        },
        "sdd.agente": {
          "type": "string",
          "enum": ["claude", "cursor", "codex", "opencode", "agy"],
          "enumDescriptions": ["Claude Code", "Cursor (CLI agent)", "Codex (GPT)", "OpenCode", "Antigravity (agy)"],
          "default": "claude",
          "description": "IA que recebe os comandos do Spec Kit. Se a integração dela não estiver no repositório, a extensão oferece instalar."
        },
        "sdd.listaClickUp": {
          "type": "string",
          "default": "",
          "description": "Lista do ClickUp sugerida em \"Enviar ao ClickUp\" (ex.: Sprint 1 (14/10 - 3/11))."
        },
        "sdd.layout.colunas": {
          "type": "string",
          "enum": ["auto", "1", "2"],
          "default": "auto",
          "enumDescriptions": ["Duas colunas quando houver espaco", "Sempre uma coluna", "Sempre duas colunas"],
          "description": "Define quantas colunas as webviews usam."
        },
        "sdd.layout.densidade": {
          "type": "string",
          "enum": ["confortavel", "compacta"],
          "default": "confortavel",
          "description": "Define o espacamento das webviews."
        }
      }
    },
    "commands": [
      { "command": "sdd.instalarOrq", "title": "SDD: Instalar skills de orquestra\u00e7\u00e3o (/orq)", "icon": "$(hubot)" },
      { "command": "sdd.novaFeature", "title": "SDD: Nova feature", "icon": "$(add)" },
      { "command": "sdd.atualizar", "title": "SDD: Atualizar", "icon": "$(refresh)" },
      { "command": "sdd.atualizarExtensao", "title": "SDD: Atualizar extensão (última versão)", "icon": "$(extensions)" },
      { "command": "sdd.vincularClickUp", "title": "SDD: Vincular ClickUp ao repositorio", "icon": "$(link)" },
      { "command": "sdd.abrirClickUp", "title": "SDD: Abrir no ClickUp", "icon": "$(link-external)" },
      { "command": "sdd.abrirBranch", "title": "SDD: Abrir branch da feature", "icon": "$(git-branch)" },
      { "command": "sdd.buscarEquipe", "title": "SDD: Buscar features da equipe (git fetch)", "icon": "$(cloud-download)" },
      { "command": "sdd.instalarSpecKit", "title": "SDD: Instalar Spec Kit neste repositório", "icon": "$(cloud-download)" },
      { "command": "sdd.proximo", "title": "SDD: Próximo passo", "icon": "$(play)" },
      { "command": "sdd.clarify", "title": "SDD: Clarify (tirar dúvidas da spec)" },
      { "command": "sdd.plan", "title": "SDD: Plan (plano técnico)" },
      { "command": "sdd.checklist", "title": "SDD: Checklist (qualidade dos requisitos)" },
      { "command": "sdd.tasks", "title": "SDD: Tasks (gerar tasks.md)" },
      { "command": "sdd.analyze", "title": "SDD: Analyze (conferir consistência)" },
      { "command": "sdd.implement", "title": "SDD: Implement (implementar)" },
      { "command": "sdd.converge", "title": "SDD: Converge (o que falta)" },
      { "command": "sdd.taskstoclickup", "title": "SDD: Enviar ao ClickUp" },
      { "command": "sdd.wiki", "title": "SDD: Wiki da feature", "icon": "$(book)" },
      { "command": "sdd.excluirFeature", "title": "SDD: Excluir feature", "icon": "$(trash)" },
      { "command": "sdd.configurarLayout", "title": "SDD: Layout do painel", "icon": "$(settings-gear)" }
    ],
    "menus": {
      "view/title": [
        { "command": "sdd.novaFeature", "when": "view == sdd.features", "group": "navigation@1" },
        { "command": "sdd.atualizar", "when": "view == sdd.features", "group": "navigation@2" },
        { "command": "sdd.atualizarExtensao", "when": "view == sdd.features", "group": "navigation@9" },
        { "command": "sdd.buscarEquipe", "when": "view == sdd.features", "group": "navigation@3" },
        { "command": "sdd.wiki", "when": "view == sdd.status", "group": "navigation@1" },
        { "command": "sdd.configurarLayout", "when": "view == sdd.form", "group": "navigation@1" }
      ],
      "commandPalette": [
        { "command": "sdd.instalarOrq" },
        { "command": "sdd.instalarSpecKit", "when": "false" },
        { "command": "sdd.excluirFeature" }
      ],
      "view/item/context": [
        { "command": "sdd.novaFeature", "when": "viewItem == repo", "group": "inline" },
        { "command": "sdd.abrirClickUp", "when": "viewItem == repo", "group": "inline" },
        { "command": "sdd.abrirClickUp", "when": "viewItem == repo", "group": "5_clickup@1" },
        { "command": "sdd.vincularClickUp", "when": "viewItem == repo", "group": "5_clickup@2" },
        { "command": "sdd.abrirClickUp", "when": "viewItem == feature", "group": "4_clickup@2" },
        { "command": "sdd.abrirBranch", "when": "viewItem == featureOutraBranch", "group": "inline" },
        { "command": "sdd.abrirBranch", "when": "viewItem == featureOutraBranch", "group": "0_branch@1" },
        { "command": "sdd.instalarSpecKit", "when": "viewItem == repoSemSpecKit", "group": "inline" },
        { "command": "sdd.wiki", "when": "viewItem == feature", "group": "0_wiki@1" },
        { "command": "sdd.wiki", "when": "viewItem == feature", "group": "inline" },
        { "command": "sdd.excluirFeature", "when": "viewItem == feature", "group": "9_excluir@1" },
        { "command": "sdd.proximo", "when": "viewItem == feature", "group": "inline" },
        { "command": "sdd.wiki", "when": "view == sdd.status && viewItem == featureStatus", "group": "0_wiki@1" },
        { "command": "sdd.wiki", "when": "view == sdd.status && viewItem == featureStatus", "group": "inline" },
        { "command": "sdd.excluirFeature", "when": "view == sdd.status && viewItem == featureStatus", "group": "9_excluir@1" },
        { "command": "sdd.clarify", "when": "viewItem == feature", "group": "1_spec@1" },
        { "command": "sdd.checklist", "when": "viewItem == feature", "group": "1_spec@2" },
        { "command": "sdd.plan", "when": "viewItem == feature", "group": "2_plano@1" },
        { "command": "sdd.tasks", "when": "viewItem == feature", "group": "2_plano@2" },
        { "command": "sdd.analyze", "when": "viewItem == feature", "group": "2_plano@3" },
        { "command": "sdd.implement", "when": "viewItem == feature", "group": "3_codigo@1" },
        { "command": "sdd.converge", "when": "viewItem == feature", "group": "3_codigo@2" },
        { "command": "sdd.taskstoclickup", "when": "viewItem == feature", "group": "4_clickup@1" }
      ]
    }
  }
}
